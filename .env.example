# ─────────────────────────────────────────────────────────────
# Balia — variables d'environnement (exemple)
# Copie ce fichier en `.env.local` et remplis avec TES clés.
# NE JAMAIS committer `.env.local` (il est ignoré par git).
# ─────────────────────────────────────────────────────────────

# Supabase (région UE — cf. Bible Tome 22 RGPD)
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Clé service_role : usage SERVEUR uniquement (webhooks, jobs). Jamais exposée au client.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Anthropic (cerveau de l'agent — modèle claude-fable-5)
ANTHROPIC_API_KEY=sk-ant-...

# Twilio (numéro + voix + SMS)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+33...

# Vapi ou Retell (pipeline vocal clé-en-main)
VAPI_API_KEY=...
# RETELL_API_KEY=...
# Secret partagé pour authentifier les webhooks vocaux (header x-balia-secret).
# Génère une valeur aléatoire et configure-la côté Vapi/Retell.
VOCAL_WEBHOOK_SECRET=

# Stripe (abonnements — Jour 3, optionnel)
STRIPE_SECRET_KEY=sk_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_...
