# --- IA (Claude API) ---
# Sans clé, Balia tourne en mode démo (agents avec sorties simulées déterministes).
ANTHROPIC_API_KEY=
# Sonnet pour le volume, Opus pour le raisonnement complexe (cf. Bible, Tome 10)
BALIA_MODEL_VOLUME=claude-sonnet-5
BALIA_MODEL_COMPLEX=claude-opus-4-8

# --- Données (Supabase) ---
# Sans ces variables, Balia utilise un store en mémoire (démo / dev local).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Comms (Twilio) ---
# Sans ces variables, les envois sortants sont simulés (journalisés, jamais envoyés).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
